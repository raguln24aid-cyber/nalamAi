# Copy to .env and fill in real values. Never commit .env.
# Loaded at build time via flutter_dotenv (see mobile/lib/core/config/env.dart).
# No provider API keys belong here — the app only ever talks to our own backend.

API_BASE_URL=http://10.0.2.2:4000/api/v1
# ^ 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
#   Use http://localhost:4000/api/v1 for iOS simulator, or your LAN IP for a real device.

ENVIRONMENT=development
ENABLE_CLOUD_TTS_FALLBACK=true
ENABLE_CLOUD_STT_FALLBACK=false
DEFAULT_LANGUAGE=auto
