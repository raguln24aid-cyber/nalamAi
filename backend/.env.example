# Copy to .env and fill in real values. Never commit .env.
# See docs/API_CONTRACTS.md and ARCHITECTURE.md for how these are used.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string (see backend/README.md for local docker-compose setup).
# Port 5433 here because the bundled docker-compose.yml maps to 5433 on the host to avoid
# clashing with a native Postgres install that may already be using 5432 — adjust if your
# setup differs.
DATABASE_URL=postgresql://nalamai:nalamai@localhost:5433/nalamai?schema=public

# JWT signing secrets — generate with `openssl rand -base64 48`. Rotate independently.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated list of allowed origins for the mobile app / any web admin tooling
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OCR / Vision provider ---------------------------------------------------
# One of: google-vision | groq | mock
OCR_PROVIDER=google-vision
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# Path to a service-account JSON key OR the JSON contents themselves (base64-encoded)
GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=

# --- Barcode product lookup ---------------------------------------------------
BARCODE_PROVIDER=open-food-facts
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# --- AI Food Assistant (LLM) ---------------------------------------------------
# One of: anthropic | groq | mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-5

# --- Groq (groq.com — fast inference for open models, OpenAI-compatible API) --
# NOT the same as xAI's "Grok" model, despite the near-identical name; a Groq key looks like
# gsk_... . Set AI_PROVIDER=groq and/or OCR_PROVIDER=groq to use it — one key covers both the
# AI Food Assistant and image-based label transcription (via a vision-capable Groq model).
GROQ_API_KEY=
# Groq's model catalog is account-specific and changes over time — verify with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Text-to-Speech fallback (used when on-device TTS is insufficient) --------
TTS_PROVIDER=google-cloud-tts
# Reuses GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64 above.

# --- Speech-to-Text fallback (server-side, optional — on-device is primary) ---
STT_PROVIDER=google-cloud-stt

# --- Feature flags / data retention --------------------------------------------
RETAIN_SCAN_IMAGES=false

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
